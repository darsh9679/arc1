# Set the final canonical origin before deploying to a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false until the real content, brand and contact details are approved.
NEXT_PUBLIC_LAUNCH_READY=false
# Optional server-only HTTPS endpoint accepting enquiry JSON. Never use NEXT_PUBLIC_ for secrets.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
# Google Sheets delivery takes priority over the generic webhook when configured.
# Deploy integrations/google-sheets/Code.gs as a Google Apps Script web app.
# Use the permanent https://script.google.com/macros/s/DEPLOYMENT_ID/exec URL.
GOOGLE_SHEETS_WEB_APP_URL=
# Same value as the Apps Script ENQUIRY_TOKEN property (at least 32 characters).
GOOGLE_SHEETS_WEB_APP_TOKEN=
